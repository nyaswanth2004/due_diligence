# ------------------------------------------------------------------
# VeritasIQ – environment template for Docker Compose
#
#   cp .env.example .env
#   # then set a real SECRET_KEY and the initial admin password
#   docker compose up -d --build
# ------------------------------------------------------------------

# --- Security -----------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# --- App ----------------------------------------------------------
DEBUG=false
# Host port mapped to the app container (port 8000 inside the container).
APP_PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Ollama connection (used by the app container) -----------------
# Inside the Compose network the app reaches Ollama at this address.
# This is the recommended way to configure the Ollama URL.
OLLAMA_HOST=http://ollama:11434
# Optional fallback for local (non-Docker) development:
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama model(s) to pull automatically on first start (space-separated).
# Must include the LLM model referenced by LLM_MODEL below.
OLLAMA_MODELS=qwen2.5:3b

# --- LLM -----------------------------------------------------------
# Backends: "ollama" (local), "groq" (free cloud API), "fake" (tests).
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
QA_MAX_HISTORY=6
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=600
OLLAMA_KEEP_ALIVE=10m

# --- Groq cloud LLM (free tier, no Ollama needed) ------------------
# Get a free API key at https://console.groq.com
# Only used when LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- CORS ----------------------------------------------------------
# The SPA is served from the same origin as the API, so no entries are
# required. Add any browser origins that call the API directly, e.g.:
#   CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGINS=["http://localhost:8000"]

# --- Database ------------------------------------------------------
# Single-container default: SQLite on the app-data volume.
DATABASE_URL=sqlite:////app/data/veritasiq.db
# To use Postgres instead, start a postgres service (see docker-compose.yml)
# and set: DATABASE_URL=postgresql://veritasiq:veritasiq@postgres:5432/veritasiq

# --- Storage & vectors (persisted on the app-data volume) ----------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/data/storage/documents
VECTOR_STORE_BACKEND=local
VECTOR_INDEX_PATH=/app/data/storage/vectors
VECTOR_DIM=384
# Hugging Face cache for sentence-transformers + reranker lives on app-data
# so models are not re-downloaded on every container restart.
HF_HOME=/app/data/hf

# --- Embeddings -----------------------------------------------------
# Backends: sentence_transformers (local PyTorch) | ollama (via Ollama) |
#           hash (deterministic, tests/offline dev only)
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval ------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_FUSION_K=60
KEYWORD_ENABLED=true
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking -------------------------------------------------------
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# --- Uploads / OCR --------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.xlsx,.xls,.csv
# auto | tesseract | rapidocr
OCR_ENGINE=auto

# --- Initial admin user (created automatically on first start) ------
# Set ADMIN_BOOTSTRAP=true and provide credentials. Seeding is idempotent,
# so it is safe to leave enabled across restarts.
ADMIN_BOOTSTRAP=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_ROLE=admin

# --- Optional external services (only needed when enabled above) ----
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET_DOCUMENTS=documents
# REDIS_URL=redis://redis:6379/0
