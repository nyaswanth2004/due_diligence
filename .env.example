# --- Application ---
DEBUG=false
# REQUIRED in production: long random secret used to sign access tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
# Local dev (no Docker): DATABASE_URL=sqlite:///./veritasiq.db
DATABASE_URL=postgresql://veritasiq:veritasiq@localhost:5432/veritasiq

# --- Redis (queue/cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage/documents
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=documents

# --- Local LLM ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
# LLM backends: ollama (local) | fake (deterministic, tests/offline dev)
LLM_BACKEND=ollama
LLM_TEMPERATURE=0.1
QA_MAX_HISTORY=6

# --- Due diligence report ---
# Draft an LLM executive summary (falls back to a deterministic note if the
# LLM backend is unavailable or disabled).
REPORT_NARRATIVE_ENABLED=true

# --- Embeddings ---
# Backends: sentence_transformers (local PyTorch), ollama (local via Ollama),
#           hash (deterministic, tests/offline dev only)
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Vector index ---
# Backends: local (dev, no Docker) | pgvector (production Postgres)
VECTOR_STORE_BACKEND=local
VECTOR_DIM=384
VECTOR_INDEX_PATH=storage/vectors

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_FUSION_K=60
KEYWORD_ENABLED=true
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking ---
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
